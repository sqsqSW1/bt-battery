<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0;net48</TargetFrameworks>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net48'">x64</PlatformTarget>
    <RootNamespace>BtBattery.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Condition="'$(TargetFramework)' == 'net8.0'" Include="..\..\src\BtBattery.Core\BtBattery.Core.csproj" />
    <ProjectReference Condition="'$(TargetFramework)' == 'net48'" Include="..\..\src\BtBattery.Compact\BtBattery.Compact.csproj" />
  </ItemGroup>
</Project>
